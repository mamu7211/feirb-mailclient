meta {
  name: Login
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "{{adminUsername}}",
    "password": "{{adminPassword}}"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("accessToken", res.body.accessToken);

    // The refresh token is delivered as an HttpOnly cookie (see PR #236), not in the
    // response body. Bruno's CLI runner does not maintain a cookie jar across requests
    // in a run, so we capture the raw Set-Cookie value here and forward it explicitly
    // as a `Cookie` header on the refresh request.
    var setCookie = res.headers["set-cookie"];
    if (setCookie) {
      var cookieHeader = Array.isArray(setCookie) ? setCookie[0] : setCookie;
      var match = cookieHeader.match(/^refreshToken=([^;]+)/);
      if (match) {
        bru.setVar("refreshTokenCookie", match[1]);
      }
    }
  }
}

tests {
  test("should return 200", function() {
    expect(res.status).to.equal(200);
  });

  test("should return access token", function() {
    expect(res.body.accessToken).to.be.a("string");
  });

  test("should set refresh token as an HttpOnly cookie", function() {
    var setCookie = res.headers["set-cookie"];
    var cookieHeader = Array.isArray(setCookie) ? setCookie[0] : setCookie;
    expect(cookieHeader).to.be.a("string");
    expect(cookieHeader).to.include("refreshToken=");
    expect(cookieHeader.toLowerCase()).to.include("httponly");
  });

  test("should return expiry", function() {
    expect(res.body.expiresAt).to.be.a("string");
  });
}
