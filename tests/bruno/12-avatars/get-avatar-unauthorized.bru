meta {
  name: Get Avatar Anonymous - No Content
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/api/avatars/00000000000000000000000000000000
  body: none
  auth: none
}

tests {
  // The endpoint is anonymous by design (avatars are public), and the API returns 204
  // (not 404) when no avatar exists for a hash (see PR #225).
  test("should return 204 for non-existent avatar", function() {
    expect(res.status).to.equal(204);
  });
}
