# Bruno CLI test runner
# Build context: repository root (..)

FROM docker.io/library/node:22-alpine

RUN apk add --no-cache curl
# Pin to the current major so a future @usebruno/cli release doesn't silently change
# runner behavior (e.g. cookie handling, reporting) out from under this test suite.
RUN npm install -g @usebruno/cli@4

WORKDIR /app
COPY tests/bruno/ .

COPY tests/wait-for-api.sh /usr/local/bin/wait-for-api
RUN chmod +x /usr/local/bin/wait-for-api

ENTRYPOINT ["sh", "-c", "wait-for-api && bru run --env docker"]
